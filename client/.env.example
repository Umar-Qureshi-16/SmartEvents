# Copy to .env and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to the browser.

# REST API base, including the version prefix. Keep it relative (the default):
# Vite (dev) and Vercel (prod, see vercel.json) proxy /api to the backend so the
# httpOnly session cookies are first-party.
VITE_API_URL=/api/v1

# Socket.IO origin (no path, no version prefix). Sockets cannot go through the
# proxy, so this points straight at the backend. In production it also lets the
# app wake a sleeping free-tier backend while the page loads.
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
