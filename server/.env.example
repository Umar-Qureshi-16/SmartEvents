# Copy to .env and fill in. Validated at boot by config/env.js — the server
# refuses to start if anything required is missing or malformed.

# --- Core (required) ---------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_events

# Signing key for JWTs. Must be at least 16 characters; generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value, and never reuse it across environments.
JWT_SECRET=replace-me-with-a-long-random-string

JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ----------------------------------------------------------------
# Comma-separated CORS whitelist and the base used in password-reset links.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173

# --- AI (optional) -----------------------------------------------------------
# Without these, AI endpoints fall back to static content rather than failing.
GROQ_API_KEY=
# Optional overrides (defaults: llama-3.3-70b-versatile / llama-3.1-8b-instant)
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GEMINI_API_KEY=

# --- Google OAuth 2.0 (optional) ---------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email (optional) --------------------------------------------------------
# Without these, mailService logs to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartEvents <no-reply@smartevents.local>
